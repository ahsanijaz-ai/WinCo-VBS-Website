# Copy this file to .env.local and fill in the values. Never commit .env.local.

# The live site address, no trailing slash, e.g. https://www.example.com
# Leave empty until the domain is bought: Vercel's own address is used instead.
NEXT_PUBLIC_SITE_URL=

# Web3Forms (contact form email) - https://web3forms.com
# Inquiries go to the email address the access key was created for. The key is public by design.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Cloudflare Turnstile (spam protection)
# Test keys for local and preview: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limiting) - https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
